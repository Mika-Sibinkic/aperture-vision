# Aperture Bridge — env for the Dell G7 systemd service
# Copy to /etc/aperture-bridge.env and chmod 600 (root-only readable)

# Hik-Connect credentials (created during camera setup — see docs/HIK-CONNECT-SETUP.md)
EZVIZ_ACCOUNT=aperture@example.com
EZVIZ_PASSWORD=CHANGE_ME_strong_password_here
EZVIZ_REGION=apiius.ezvizlife.com

# The camera's 9-digit Hikvision serial (bottom-right of device, or UI → System → Device Info)
CAMERA_SERIAL=CHANGE_ME_9_digit_serial

# Shared secret between this bridge and n8n.
# Generate with:  openssl rand -hex 32
BRIDGE_TOKEN=CHANGE_ME_64_hex_chars

# Snapshot dedupe window (so two presses within 0.5s share one JPEG)
SNAPSHOT_TTL_S=0.5

# Port the bridge listens on (localhost only — Cloudflare tunnel fronts it)
LISTEN_PORT=8002
