# Aperture appliance — environment template.
# Copy to deploy/.env and fill in the slots marked ⇨.
# This file is gitignored.

# ── Vision provider ──────────────────────────────────────────────────────────
# Required for the demo harness's real (non-stub) provider. Any OpenAI key
# with gpt-4o vision access works. For EnterpriseCo deployment this is replaced with
# on-prem Jetson Orin Nano inference; no API key needed in production.
OPENAI_API_KEY=⇨

# ── Hikvision Hik-Connect (static-mode bridge only) ──────────────────────────
# Credentials for the camera's cloud account. Only needed if running the
# aperture-bridge service. Conveyor-mode EnterpriseCo deployment uses direct GigE
# camera access and does not need any of these.
EZVIZ_REGION=apiius.ezvizlife.com
EZVIZ_ACCOUNT=⇨
EZVIZ_PASSWORD=⇨
CAMERA_SERIAL=⇨

# ── Bridge auth ──────────────────────────────────────────────────────────────
# Shared secret between n8n / your workflow runtime and the bridge. Generate
# with: python -c "import secrets;print(secrets.token_hex(32))"
BRIDGE_TOKEN=⇨

# ── Bridge tuning (sane defaults) ────────────────────────────────────────────
SNAPSHOT_TTL_S=0.5
LISTEN_PORT=8002
